//@version=6
// AMD + Time + IFVG, 0.5R target - same rules as bot/strategy.py (use_ifvg=True, asia_hours=4).
//   Asian range : 20:00-00:00 ET.   Bias: first sweep of the Asian high/low between 00:00 and 11:00.
//   Entry       : 5m close through the latest opposing FVG formed since midnight, only in the
//                 killzones 02:00-05:00 and 08:30-11:00 ET.  One trade per day.
//   Stop        : manipulation extreme (session low for longs / high for shorts).
//   Target      : 0.5R.  Flat at 15:55 ET.
// Sends TradersPost-format JSON alerts (TradersPost -> Tradovate -> Lucid).
// Pine v6. Not yet confirmed on TradingView: check it in the Strategy Tester and on paper first. Use MNQ1!, 5-minute chart.
strategy("AMD+IFVG 0.5R (TradersPost)", overlay=true, pyramiding=0, default_qty_type=strategy.fixed, default_qty_value=1, calc_on_every_tick=false)

// TradersPost message helpers (kept on single lines: Pine is strict about wrapped lines)
entryMsg(string side, float qty, float stopPx, float tgtPx) =>
    j = '{"ticker":"' + syminfo.ticker + '","action":"' + side + '","quantity":' + str.tostring(qty, "#")
    j := j + ',"stopLoss":{"type":"stop","stopPrice":' + str.tostring(stopPx, format.mintick) + '}'
    j := j + ',"takeProfit":{"limitPrice":' + str.tostring(tgtPx, format.mintick) + '}}'
    j
exitMsg() =>
    '{"ticker":"' + syminfo.ticker + '","action":"exit"}'

riskUsd  = input.float(200, "Max $ risk per trade (eval 200, funded 150)")
maxQty   = input.int(20, "Max contracts (Lucid 25K: 20 micros)")
costPts  = input.float(1.0, "Cost per contract (points)")
targetR  = input.float(0.5, "Target in R")
minAsia  = input.int(24, "Min 5m bars in Asian range")

tz   = "America/New_York"
h    = hour(time, tz)
mins = h * 60 + minute(time, tz)
hPrev = hour(time[1], tz)

var float aHi = na
var float aLo = na
var int   aBars = 0
var int   bias = 0
var float runLo = na
var float runHi = na
var float bearTop = na
var float bullBot = na
var int   sessBars = 0
var bool  done = false

// ---- Accumulation: Asian range 20:00-23:55 ET
if h >= 20
    if hPrev < 20 or na(hPrev)
        aHi := high
        aLo := low
        aBars := 1
    else
        aHi := math.max(aHi, high)
        aLo := math.min(aLo, low)
        aBars += 1

// ---- New session (first bar after the Asian window): reset the day
if h < 20 and hPrev >= 20
    bias := 0
    runLo := na
    runHi := na
    bearTop := na
    bullBot := na
    sessBars := 0
    done := false

inKZ  = (mins >= 120 and mins < 300) or (mins >= 510 and mins < 660)
inSes = h < 11
goLong = false
goShort = false

if inSes and not done and aBars >= minAsia
    sessBars += 1
    runLo := na(runLo) ? low : math.min(runLo, low)
    runHi := na(runHi) ? high : math.max(runHi, high)
    if sessBars >= 3
        if high < low[2]
            bearTop := low[2]
        if low > high[2]
            bullBot := high[2]
    if bias == 0
        bias := low < aLo ? 1 : high > aHi ? -1 : 0      // manipulation sweep sets the bias; no entry this bar
    else if inKZ
        goLong  := bias == 1 and not na(bearTop) and close > bearTop
        goShort := bias == -1 and not na(bullBot) and close < bullBot

if (goLong or goShort) and strategy.position_size == 0
    done := true
    stopPx = goLong ? runLo : runHi
    dist   = math.abs(close - stopPx)
    qty    = dist > 0 ? math.min(maxQty, math.floor(riskUsd / ((dist + costPts) * syminfo.pointvalue))) : 0
    if qty >= 1
        tgtPx = goLong ? close + targetR * dist : close - targetR * dist
        side  = goLong ? "buy" : "sell"
        strategy.entry(goLong ? "L" : "S", goLong ? strategy.long : strategy.short, qty, alert_message=entryMsg(side, qty, stopPx, tgtPx))
        strategy.exit(goLong ? "L-x" : "S-x", goLong ? "L" : "S", stop=stopPx, limit=tgtPx, alert_message=exitMsg())

if mins >= 15 * 60 + 55 and h < 17 and strategy.position_size != 0
    strategy.close_all(comment="EOD", alert_message=exitMsg())

plot(aBars >= minAsia ? aHi : na, "Asian high", color=color.new(color.green, 0), style=plot.style_linebr)
plot(aBars >= minAsia ? aLo : na, "Asian low", color=color.new(color.red, 0), style=plot.style_linebr)
